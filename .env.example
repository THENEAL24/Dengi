# Optional: same-origin sync API (default /api/v1)
# VITE_SYNC_API_BASE=/api/v1

# Vercel Storage → Redis → Connect project → injects REDIS_URL (rediss://…)
# API uses REDIS_URL directly (Node serverless, not REST).

# Local `npm run dev`: /api proxied to prod unless overridden
# VITE_DEV_API_PROXY=https://dengi-fawn.vercel.app
